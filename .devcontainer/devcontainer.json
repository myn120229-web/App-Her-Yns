{
  "name": "unemployed (Codespaces edition)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },

  "forwardPorts": [8501, 11434],
  "portsAttributes": {
    "8501": { "label": "unemployed app", "onAutoForward": "openBrowser" },
    "11434": { "label": "Ollama API", "onAutoForward": "silent" }
  },

  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start_ollama.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  }
}
